<%= simple_form_for(@member, html: { class: "contents" }) do |form| %>
  <% if member.errors.any? %>
    <div id="error_explanation" class="bg-health-red-50 dark:bg-health-red-900/20 text-health-red-600 dark:text-health-red-400 px-4 py-3 rounded-lg mb-6">
      <div class="flex items-center mb-2">
        <%= lucide_icon('alert-circle', class: 'h-5 w-5 mr-2') %>
        <h2 class="font-medium"><%= pluralize(member.errors.count, "erro") %> impediram o cadastro:</h2>
      </div>
      <ul class="list-disc pl-5 space-y-1 text-sm">
        <% member.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="p-6">
    <div class="mb-6 bg-gray-50 dark:bg-gray-700 p-6 rounded-lg">
      <div class="flex items-center mb-4">
        <%= lucide_icon('info', class: 'h-5 w-5 text-pharma-teal-500 mr-2') %>
        <h3 class="font-medium text-gray-900 dark:text-white">Informações do Membro</h3>
      </div>
      
      <div class="grid grid-cols-1 gap-4">
        <div>
          <%= form.label :name, "Nome do Membro", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= form.input :name, label: false, input_html: { class: "input-field dark:bg-gray-700 dark:border-gray-600 dark:text-white" } %>
        </div>
        
        <% if current_profile.admin? %>
          <div>
            <%= form.label :profile_id, "Perfil Associado", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
            <%= form.association :profile, 
                              label: false, 
                              prompt: "Selecione o perfil",
                              include_blank: false,
                              input_html: { class: "input-field dark:bg-gray-700 dark:border-gray-600 dark:text-white" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="px-6 py-4 bg-gray-50 dark:bg-gray-700 flex justify-end space-x-3">
    <%= form.button :submit, 
                  @member.new_record? ? "Cadastrar Membro" : "Atualizar Membro", 
                  class: "btn-primary inline-flex items-center" %>
  </div>
<% end %>
