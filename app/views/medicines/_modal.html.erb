<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50 transition-opacity duration-300 opacity-0 pointer-events-none" data-controller="modal" data-modal-target="modal" data-action="click->modal#closeWithBackdrop">
    <div class="bg-white dark:bg-gray-800 rounded-xl overflow-hidden shadow-xl transform transition-all sm:max-w-2xl sm:w-full max-h-[90vh] m-4" data-modal-target="dialog" data-action="click->modal#stopPropagation">
      <div class="bg-pharma-teal-600 dark:bg-pharma-teal-600 px-6 py-4 flex justify-between items-center">
        <h3 class="text-lg font-medium text-white"><%= title %></h3>
        <button type="button" class="text-white hover:text-gray-200 focus:outline-none transition-colors" data-action="modal#close" aria-label="Fechar">
          <%= lucide_icon('x', class: 'h-5 w-5') %>
        </button>
      </div>
      <div class="overflow-y-auto" style="max-height: calc(90vh - 4rem);" id="modal_body">
        <%= yield %>
      </div>
    </div>
  </div>
<% end %>
