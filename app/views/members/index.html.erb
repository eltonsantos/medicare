<% content_for :title, "Membros" %>

<div class="mb-8">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-bold text-pharma-teal-700 dark:text-pharma-teal-400">Membros</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-1">Gerenciamento de membros da família</p>
    </div>
    <%= link_to new_member_path, 
                class: "btn-primary flex items-center justify-center md:justify-start",
                data: { turbo_frame: "modal" } do %>
      <%= lucide_icon('plus', class: 'h-5 w-5 mr-2') %>
      <span>Cadastrar Membro</span>
    <% end %>
  </div>

  <div class="mb-4 p-4 bg-pharma-teal-50 dark:bg-gray-800 rounded-lg border border-pharma-teal-100 dark:border-gray-700">
    <div class="flex items-center">
      <%= lucide_icon('info', class: 'h-5 w-5 text-pharma-teal-500 mr-3') %>
      <p class="text-gray-700 dark:text-gray-300">
        Gerencie os membros da família que utilizarão medicamentos.
      </p>
    </div>
  </div>

  <div id="members" class="w-full overflow-hidden bg-white dark:bg-gray-800 rounded-lg shadow-soft">
    <% if @members.any? %>
      <div class="overflow-x-auto">
        <table class="w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th class="table-header w-1/2">Nome</th>
              <th class="table-header w-1/3">Perfil</th>
              <th class="table-header w-1/6">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
            <% @members.each do |member| %>
              <tr id="<%= dom_id member %>" class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                <td class="table-cell">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10 bg-pharma-teal-100 text-pharma-teal-600 dark:bg-gray-700 dark:text-pharma-teal-400 rounded-full flex items-center justify-center mr-3">
                      <%= lucide_icon('user-round', class: 'h-5 w-5') %>
                    </div>
                    <div class="font-medium text-gray-900 dark:text-white"><%= member.name %></div>
                  </div>
                </td>
                <td class="table-cell text-gray-900 dark:text-white"><%= member.profile.name %></td>
                <td class="table-cell">
                  <div class="flex space-x-1">
                    <%= link_to member, 
                                class: "p-2 text-pharma-blue-600 hover:bg-pharma-blue-50 dark:text-pharma-blue-400 dark:hover:bg-gray-700 rounded-full", 
                                title: "Visualizar",
                                data: { turbo_frame: "modal" } do %>
                      <%= lucide_icon('eye', class: 'h-5 w-5') %>
                    <% end %>
                    
                    <%= link_to edit_member_path(member), 
                                class: "p-2 text-pharma-teal-600 hover:bg-pharma-teal-50 dark:text-pharma-teal-400 dark:hover:bg-gray-700 rounded-full", 
                                title: "Editar",
                                data: { turbo_frame: "modal" } do %>
                      <%= lucide_icon('pencil', class: 'h-5 w-5') %>
                    <% end %>
                    
                    <%= link_to member, 
                                method: :delete, 
                                class: "p-2 text-health-red-600 hover:bg-health-red-50 dark:text-health-red-400 dark:hover:bg-gray-700 rounded-full", 
                                title: "Excluir",
                                data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir este membro?" } do %>
                      <%= lucide_icon('trash', class: 'h-5 w-5') %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="flex flex-col items-center justify-center py-12 px-4 text-center">
        <%= lucide_icon('users', class: 'h-16 w-16 text-gray-400 mb-4') %>
        <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Nenhum membro cadastrado</h3>
        <p class="text-gray-500 dark:text-gray-400 max-w-md mb-6">
          Cadastre membros de sua família para gerenciar a medicação por pessoa.
        </p>
        <%= link_to new_member_path, 
                    class: "btn-primary inline-flex items-center", 
                    data: { turbo_frame: "modal" } do %>
          <%= lucide_icon('plus', class: 'mr-2 h-5 w-5') %>
          Cadastrar primeiro membro
        <% end %>
      </div>
    <% end %>
  </div>
</div>
