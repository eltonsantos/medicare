<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-pharma-teal-50 to-pharma-blue-50 dark:from-gray-900 dark:to-gray-800 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white dark:bg-gray-800 rounded-xl shadow-xl p-8">
    <div>
      <div class="flex justify-center">
        <div class="h-24 w-24 bg-pharma-teal-100 text-pharma-teal-600 dark:bg-gray-700 dark:text-pharma-teal-400 rounded-full flex items-center justify-center">
          <%= lucide_icon('briefcase-medical', class: 'h-12 w-12') %>
        </div>
      </div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-pharma-teal-700 dark:text-pharma-teal-400">
        Faça login na sua conta
      </h2>
      <p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
        Sua farmácia pessoal
      </p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.error_notification %>

      <% if resource.errors.any? %>
        <div id="error_explanation" data-turbo-cache="false" class="bg-health-red-50 dark:bg-health-red-900/20 text-health-red-600 dark:text-health-red-400 px-4 py-3 rounded-lg mb-6">
          <div class="flex items-center mb-2">
            <%= lucide_icon('alert-circle', class: 'h-5 w-5 mr-2') %>
            <h2 class="font-medium">
              <%= I18n.t("errors.messages.not_saved",
                       count: resource.errors.count,
                       resource: resource.class.model_name.human.downcase) %>
            </h2>
          </div>
          <ul class="list-disc pl-5 space-y-1 text-sm">
            <% resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <div class="space-y-5 mt-6">
        <div>
          <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.input_field :email, required: true, autofocus: true, autocomplete: "email", 
                          class: "input-field dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
        </div>

        <div>
          <%= f.label :password, "Senha", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.input_field :password, required: true, autocomplete: "current-password", 
                          class: "input-field dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center">
            <%= f.input_field :remember_me, as: :boolean, 
                            class: "h-4 w-4 text-pharma-teal-600 dark:text-pharma-teal-400 focus:ring-pharma-teal-500 border-gray-300 dark:border-gray-600 rounded" %>
            <%= f.label :remember_me, "Lembrar-me", class: "ml-2 block text-sm text-gray-700 dark:text-gray-300" %>
          </div>
        <% end %>
      </div>

      <div class="mt-6">
        <%= f.button :submit, "Entrar", class: "btn-primary w-full flex justify-center" %>
      </div>
    <% end %>

    <div class="mt-4 text-center text-sm">
      <% if devise_mapping.recoverable? %>
        <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "text-pharma-teal-600 dark:text-pharma-teal-400 hover:text-pharma-teal-500 dark:hover:text-pharma-teal-300 font-medium" %>
      <% end %>
      
      <!-- <% if devise_mapping.registerable? %>
        <div class="mt-3">
          Não tem uma conta?
          <%= link_to "Cadastre-se", new_registration_path(resource_name), class: "text-pharma-teal-600 dark:text-pharma-teal-400 hover:text-pharma-teal-500 dark:hover:text-pharma-teal-300 font-medium ml-1" %>
        </div>
      <% end %> -->
    </div>
  </div>
</div>
