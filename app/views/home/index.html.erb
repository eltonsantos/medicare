<% content_for :title, "Medicare - Dashboard" %>

<div class="mb-8">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
    <div>
      <h1 class="text-3xl font-bold text-pharma-teal-700 dark:text-pharma-teal-400">Dashboard</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-1">Bem-vindo a sua farmácia pessoal</p>
    </div>
  </div>

  <% if @medicine.last.nil? && @symptom.last.nil? %>
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-soft overflow-hidden">
      <div class="p-8 text-center">
        <div class="w-24 h-24 bg-pharma-teal-100 dark:bg-gray-700 text-pharma-teal-600 dark:text-pharma-teal-400 rounded-full flex items-center justify-center mx-auto mb-6">
          <%= lucide_icon('pill', class: 'h-12 w-12') %>
        </div>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Bem-vindo à Medicare</h2>
        <p class="text-gray-600 dark:text-gray-400 max-w-md mx-auto mb-8">
          Sua farmácia particular e digital! Comece cadastrando seus medicamentos e sintomas para uma melhor organização.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <%= link_to new_medicine_path, class: "btn-primary", data: { turbo_frame: "modal" } do %>
            <%= lucide_icon('pill', class: 'h-5 w-5 mr-2') %>
            Cadastrar Remédio
          <% end %>
          <%= link_to new_symptom_path, class: "btn-secondary", data: { turbo_frame: "modal" } do %>
            <%= lucide_icon('thermometer', class: 'h-5 w-5 mr-2') %>
            Cadastrar Sintoma
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="card p-6">
        <div class="flex items-center mb-4">
          <div class="w-12 h-12 rounded-lg bg-pharma-teal-100 dark:bg-gray-700 text-pharma-teal-600 dark:text-pharma-teal-400 flex items-center justify-center mr-4">
            <%= lucide_icon('pill', class: 'h-6 w-6') %>
          </div>
          <div>
            <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Total de Remédios</h3>
            <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= @medicine.count %></p>
          </div>
        </div>
        <%= link_to medicines_path, class: "text-pharma-teal-600 dark:text-pharma-teal-400 hover:text-pharma-teal-700 dark:hover:text-pharma-teal-300 font-medium text-sm flex items-center" do %>
          Ver todos
          <%= lucide_icon('chevron-right', class: 'h-4 w-4 ml-1') %>
        <% end %>
      </div>
      
      <div class="card p-6">
        <div class="flex items-center mb-4">
          <div class="w-12 h-12 rounded-lg bg-pharma-blue-100 dark:bg-gray-700 text-pharma-blue-600 dark:text-pharma-blue-400 flex items-center justify-center mr-4">
            <%= lucide_icon('thermometer', class: 'h-6 w-6') %>
          </div>
          <div>
            <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Total de Sintomas</h3>
            <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= @symptom.count %></p>
          </div>
        </div>
        <%= link_to symptoms_path, class: "text-pharma-blue-600 dark:text-pharma-blue-400 hover:text-pharma-blue-700 dark:hover:text-pharma-blue-300 font-medium text-sm flex items-center" do %>
          Ver todos
          <%= lucide_icon('chevron-right', class: 'h-4 w-4 ml-1') %>
        <% end %>
      </div>
      
      <div class="card p-6">
        <div class="flex items-center mb-4">
          <div class="w-12 h-12 rounded-lg bg-health-red-100 dark:bg-gray-700 text-health-red-600 dark:text-health-red-400 flex items-center justify-center mr-4">
            <%= lucide_icon('alert-triangle', class: 'h-6 w-6') %>
          </div>
          <div>
            <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">Próximos ao Vencimento</h3>
            <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= @expiring_medicines.count %></p>
          </div>
        </div>
      </div>
    </div>
    
    <% if @expiring_medicines.any? %>
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-soft overflow-hidden mb-8">
        <div class="px-6 py-4 bg-health-red-50 dark:bg-gray-700 border-b border-health-red-100 dark:border-gray-600">
          <div class="flex items-center">
            <%= lucide_icon('alert-triangle', class: 'h-5 w-5 text-health-red-500 mr-2') %>
            <h3 class="font-medium text-gray-900 dark:text-white">Medicamentos Próximos ao Vencimento</h3>
          </div>
        </div>
        <div class="p-6">
          <ul class="divide-y divide-gray-200 dark:divide-gray-700">
            <% @expiring_medicines.each do |medicine| %>
              <li class="py-3 flex items-center justify-between">
                <div class="flex items-center">
                  <div class="w-8 h-8 bg-health-red-100 text-health-red-600 dark:bg-gray-700 dark:text-health-red-400 rounded-full flex items-center justify-center mr-3">
                    <%= lucide_icon('pill', class: 'h-4 w-4') %>
                  </div>
                  <span class="text-gray-900 dark:text-white font-medium"><%= medicine.name %></span>
                </div>
                <span class="badge badge-red">
                  Vence em <%= medicine.medicine_validity.strftime("%d/%m/%Y") %>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
    
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-soft overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
        <div class="flex items-center">
          <%= lucide_icon('info', class: 'h-5 w-5 text-pharma-teal-500 mr-2') %>
          <h3 class="font-medium text-gray-900 dark:text-white">Informações do Sistema</h3>
        </div>
      </div>
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <div class="text-sm text-gray-500 dark:text-gray-400">
            Última atualização do inventário
          </div>
          <span class="badge badge-blue">
            <%= @medicine.last ? @medicine.last.updated_at.strftime("%d/%m/%Y às %H:%M") : "Não disponível" %>
          </span>
        </div>
        
        <div class="flex flex-col sm:flex-row gap-4 mt-6">
          <%= link_to new_medicine_path, class: "btn-primary", data: { turbo_frame: "modal" } do %>
            <%= lucide_icon('plus', class: 'h-5 w-5 mr-2') %>
            Cadastrar Novo Remédio
          <% end %>
          
          <%= link_to activities_medicines_path, class: "btn-secondary" do %>
            <%= lucide_icon('history', class: 'h-5 w-5 mr-2') %>
            Ver Histórico de Atividades
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
