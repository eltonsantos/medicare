<tr id="<%= dom_id medicine %>_desktop" class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
  <td class="table-cell">
    <div class="flex items-center">
      <% if medicine.picture.attached? %>
        <div class="flex-shrink-0 h-10 w-10 mr-3">
          <%= image_tag url_for(medicine.picture), class: "h-10 w-10 rounded-full object-cover" %>
        </div>
      <% else %>
        <div class="flex-shrink-0 h-10 w-10 bg-pharma-teal-100 text-pharma-teal-600 dark:bg-gray-700 dark:text-pharma-teal-400 rounded-full flex items-center justify-center mr-3">
          <%= lucide_icon('pill', class: 'h-5 w-5') %>
        </div>
      <% end %>
      <div class="font-medium text-gray-900 dark:text-white"><%= medicine.name %></div>
    </div>
  </td>
  <td class="table-cell"><%= medicine.unit %></td>
  <td class="table-cell">
    <% if medicine.is_liquid %>
      <span class="badge badge-blue">
        <%= lucide_icon('droplets', class: 'h-3.5 w-3.5 mr-1') %>
        Líquido
      </span>
    <% else %>
      <span class="badge bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300">
        <%= lucide_icon('pill', class: 'h-3.5 w-3.5 mr-1') %>
        Sólido
      </span>
    <% end %>
  </td>
  <td class="table-cell"><%= medicine.quantity %></td>
  <td class="table-cell">
    <% days_to_expiry = (medicine.medicine_validity.to_date - Date.today).to_i %>
    <% if days_to_expiry <= 30 && days_to_expiry > 0 %>
      <span class="badge badge-red">
        <%= medicine.medicine_validity.strftime("%d/%m/%Y") %>
      </span>
    <% elsif days_to_expiry <= 0 %>
      <span class="badge bg-health-red-500 text-white">
        Vencido
      </span>
    <% else %>
      <span class="badge badge-green">
        <%= medicine.medicine_validity.strftime("%d/%m/%Y") %>
      </span>
    <% end %>
  </td>
  <td class="table-cell">
    <div class="flex flex-wrap gap-1">
      <% medicine.symptoms.each do |symptom| %>
        <span class="badge badge-blue">
          <%= symptom.name %>
        </span>
      <% end %>
      <% if medicine.symptoms.empty? %>
        <span class="text-gray-400 dark:text-gray-500 text-xs">Nenhum</span>
      <% end %>
    </div>
  </td>
  <td class="table-cell">
    <% if medicine.used_to.present? %>
      <div class="max-w-xs truncate"><%= medicine.used_to %></div>
    <% else %>
      <span class="text-gray-400 dark:text-gray-500 text-xs">Não informado</span>
    <% end %>
  </td>
  <% if current_profile.role == 'admin' %>
    <td class="table-cell"><%= medicine.profile.name %></td>
  <% end %>
  <td class="table-cell">
    <div class="flex space-x-1">
      <%= link_to medicine, 
                  class: "p-2 text-pharma-blue-600 hover:bg-pharma-blue-50 dark:text-pharma-blue-400 dark:hover:bg-gray-700 rounded-full", 
                  title: "Visualizar",
                  data: { turbo_frame: "modal" } do %>
        <%= lucide_icon('eye', class: 'h-5 w-5') %>
      <% end %>
      
      <%= link_to edit_medicine_path(medicine), 
                  class: "p-2 text-pharma-teal-600 hover:bg-pharma-teal-50 dark:text-pharma-teal-400 dark:hover:bg-gray-700 rounded-full", 
                  title: "Editar",
                  data: { turbo_frame: "modal" } do %>
        <%= lucide_icon('pencil', class: 'h-5 w-5') %>
      <% end %>
      
      <%= link_to medicine, 
                  method: :delete, 
                  class: "p-2 text-health-red-600 hover:bg-health-red-50 dark:text-health-red-400 dark:hover:bg-gray-700 rounded-full", 
                  title: "Excluir",
                  data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir este remédio?" } do %>
        <%= lucide_icon('trash', class: 'h-5 w-5') %>
      <% end %>
    </div>
  </td>
</tr> 