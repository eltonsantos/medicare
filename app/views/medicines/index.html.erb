<% content_for :title, "Remédios" %>

<div class="mb-8">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-bold text-pharma-teal-700 dark:text-pharma-teal-400">Meus Remédios</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-1">Gerenciamento completo dos seus medicamentos</p>
    </div>
    <%= link_to new_medicine_path, 
                class: "btn-primary flex items-center justify-center md:justify-start",
                data: { turbo_frame: "modal" } do %>
      <%= lucide_icon('plus', class: 'h-5 w-5 mr-2') %>
      <span>Cadastrar Remédio</span>
    <% end %>
  </div>

  <div class="mb-4 p-4 bg-pharma-teal-50 dark:bg-gray-800 rounded-lg border border-pharma-teal-100 dark:border-gray-700">
    <div class="flex items-center">
      <%= lucide_icon('info', class: 'h-5 w-5 text-pharma-teal-500 mr-3') %>
      <p class="text-gray-700 dark:text-gray-300">
        Mantenha seus medicamentos organizados e acompanhe suas validades.
      </p>
    </div>
  </div>

  <div id="medicines" class="w-full overflow-hidden bg-white dark:bg-gray-800 rounded-lg shadow-soft">
    <% if @expired_medicines.any? || @expiring_soon_medicines.any? || @regular_medicines.any? %>
      
      <% if @expired_medicines.any? %>
        <div class="py-3 px-4 bg-health-red-50 dark:bg-health-red-900/20 text-health-red-600 dark:text-health-red-400 border-b border-health-red-100 dark:border-gray-700">
          <div class="flex items-center">
            <%= lucide_icon('alert-triangle', class: 'h-5 w-5 mr-2') %>
            <h3 class="font-semibold">Medicamentos Vencidos</h3>
          </div>
        </div>
        
        <div class="lg:hidden">
          <% @expired_medicines.each do |medicine| %>
            <%= render partial: "medicine_card", locals: { medicine: medicine } %>
          <% end %>
        </div>
        
        <div class="hidden lg:block">
          <div class="overflow-x-auto">
            <table class="w-full divide-y divide-gray-200 dark:divide-gray-700">
              <thead class="bg-gray-50 dark:bg-gray-700">
                <tr>
                  <th class="table-header w-1/4">Nome</th>
                  <th class="table-header w-[10%]">Unidade(s)</th>
                  <th class="table-header w-[10%]">É líquido?</th>
                  <th class="table-header w-[10%]">Quantidade</th>
                  <th class="table-header w-[15%]">Validade</th>
                  <th class="table-header w-[15%]">Sintomas</th>
                  <th class="table-header w-[15%]">Usado para</th>
                  <% if current_profile.role == 'admin' %>
                    <th class="table-header">Usuário</th>
                  <% end %>
                  <th class="table-header w-[10%]">Ações</th>
                </tr>
              </thead>
              <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                <% @expired_medicines.each do |medicine| %>
                  <%= render partial: "medicine_row", locals: { medicine: medicine } %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
      
      <% if @expiring_soon_medicines.any? %>
        <div class="py-3 px-4 bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 border-b border-amber-100 dark:border-gray-700">
          <div class="flex items-center">
            <%= lucide_icon('alert-circle', class: 'h-5 w-5 mr-2') %>
            <h3 class="font-semibold">Medicamentos Próximos ao Vencimento</h3>
          </div>
        </div>
        
        <div class="lg:hidden">
          <% @expiring_soon_medicines.each do |medicine| %>
            <%= render partial: "medicine_card", locals: { medicine: medicine } %>
          <% end %>
        </div>
        
        <div class="hidden lg:block">
          <div class="overflow-x-auto">
            <table class="w-full divide-y divide-gray-200 dark:divide-gray-700">
              <thead class="bg-gray-50 dark:bg-gray-700">
                <tr>
                  <th class="table-header w-1/4">Nome</th>
                  <th class="table-header w-[10%]">Unidade(s)</th>
                  <th class="table-header w-[10%]">É líquido?</th>
                  <th class="table-header w-[10%]">Quantidade</th>
                  <th class="table-header w-[15%]">Validade</th>
                  <th class="table-header w-[15%]">Sintomas</th>
                  <th class="table-header w-[15%]">Usado para</th>
                  <% if current_profile.role == 'admin' %>
                    <th class="table-header">Usuário</th>
                  <% end %>
                  <th class="table-header w-[10%]">Ações</th>
                </tr>
              </thead>
              <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                <% @expiring_soon_medicines.each do |medicine| %>
                  <%= render partial: "medicine_row", locals: { medicine: medicine } %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
      
      <% if @regular_medicines.any? %>
        <div class="py-3 px-4 bg-pharma-teal-50 dark:bg-pharma-teal-900/20 text-pharma-teal-600 dark:text-pharma-teal-400 border-b border-pharma-teal-100 dark:border-gray-700">
          <div class="flex items-center">
            <%= lucide_icon('check-circle', class: 'h-5 w-5 mr-2') %>
            <h3 class="font-semibold">Outros Medicamentos</h3>
          </div>
        </div>
        
        <div class="lg:hidden">
          <% @regular_medicines.each do |medicine| %>
            <%= render partial: "medicine_card", locals: { medicine: medicine } %>
          <% end %>
        </div>
        
        <div class="hidden lg:block">
          <div class="overflow-x-auto">
            <table class="w-full divide-y divide-gray-200 dark:divide-gray-700">
              <thead class="bg-gray-50 dark:bg-gray-700">
                <tr>
                  <th class="table-header w-1/4">Nome</th>
                  <th class="table-header w-[10%]">Unidade(s)</th>
                  <th class="table-header w-[10%]">É líquido?</th>
                  <th class="table-header w-[10%]">Quantidade</th>
                  <th class="table-header w-[15%]">Validade</th>
                  <th class="table-header w-[15%]">Sintomas</th>
                  <th class="table-header w-[15%]">Usado para</th>
                  <% if current_profile.role == 'admin' %>
                    <th class="table-header">Usuário</th>
                  <% end %>
                  <th class="table-header w-[10%]">Ações</th>
                </tr>
              </thead>
              <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                <% @regular_medicines.each do |medicine| %>
                  <%= render partial: "medicine_row", locals: { medicine: medicine } %>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
      
    <% else %>
      <div class="text-center py-12">
        <div class="mx-auto w-24 h-24 bg-gray-100 dark:bg-gray-700 text-gray-400 rounded-full flex items-center justify-center mb-4">
          <%= lucide_icon('pill', class: 'h-12 w-12') %>
        </div>
        <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">Nenhum remédio cadastrado</h3>
        <p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto mb-6">
          Adicione seu primeiro remédio para gerenciar seus medicamentos.
        </p>
        <%= link_to new_medicine_path, 
                  class: "btn-primary inline-flex items-center mx-auto",
                  data: { turbo_frame: "modal" } do %>
          <%= lucide_icon('plus', class: 'h-5 w-5 mr-2') %>
          <span>Cadastrar Remédio</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
